{
  "name": "customizable-coffee-shop",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "pnpm --filter @coffee/shared build && pnpm --parallel --filter @coffee/api --filter @coffee/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @coffee/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @coffee/shared build && pnpm -r test",
    "test:coverage": "pnpm --filter @coffee/shared build && pnpm -r test:coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@next/eslint-plugin-next": "15.5.27",
    "@playwright/test": "^1.51.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0"
  }
}
